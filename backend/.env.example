PORT=4000
CLIENT_URL=http://localhost:5173
# Blockchain local (Hardhat node)
RPC_URL=http://127.0.0.1:8545
# MySQL (chạy bằng: docker compose up -d). Database tự được tạo nếu chưa có
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=caro
DB_PASSWORD=caro
DB_NAME=caro_betting
# Đăng nhập Google: OAuth client loại "Web application" (Google Cloud Console → Credentials).
# GOOGLE_CALLBACK_URL phải nằm trong "Authorized redirect URIs" của client.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
